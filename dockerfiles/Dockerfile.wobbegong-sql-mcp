# Wobbegong SQL MCP
# Build from repository root:
#   docker build -f dockerfiles/Dockerfile.wobbegong-sql-mcp -t wobbegong-sql-mcp:1.0.0 .
#
# Override the base image for air-gapped / mirrored registries:
#   --build-arg PYTHON_BASE_IMAGE=artifactory.example.local/mirror/python:3.12-slim

ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

ARG APP_USER=mcp
ARG APP_UID=10001
ARG APP_GID=10001
ARG SERVICE_PORT=8000

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_HOME=/app \
    SERVICE_PORT=${SERVICE_PORT} \
    MCP_TRANSPORT=streamable-http \
    MCP_ENDPOINT=/mcp \
    SQLITE_DB_PATH=/data/wobbegong.db

WORKDIR /app

RUN groupadd --gid "${APP_GID}" "${APP_USER}" \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --home-dir /home/${APP_USER} --shell /usr/sbin/nologin "${APP_USER}" \
    && mkdir -p /app /data \
    && chown -R "${APP_USER}:${APP_USER}" /app /data

COPY requirements/wobbegong-sql.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

# Requires src/wobbegong_sql_mcp.py (copy from the isolated environment; do not fabricate).
COPY --chown=${APP_USER}:${APP_USER} src/wobbegong_sql_mcp.py /app/wobbegong_sql_mcp.py

USER ${APP_UID}:${APP_GID}

VOLUME ["/data"]

EXPOSE ${SERVICE_PORT}

CMD ["python", "/app/wobbegong_sql_mcp.py"]
